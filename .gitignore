# ---- forensicagent: regeneratable / large artifacts ----
# Crawled third-party content is local-only. Keep sample.txt + scripts as the
# reproducible source list and ingestion path.
/data/
/seed_docs/
# RAG database + per-user state (chroma index; rebuild via `rag index-tools`)
.forensicagent/
# Chroma persistence if ever pointed inside the repo
chroma/
*.sqlite3
# Per-tool execution outputs (generated each run)
forensicagent_output/
# Historical benchmark runs; keep only bench_result/report + goldenset.json.
/bench/bench_cli/
/bench/bench_full/
/bench/bench_scripts/
# Tool YAML drafts (LLM output - human review pending)
tools_metadata/_draft/
/tools_metadata/_failures/
# Phase 6 evaluation golden set (LLM extracted)
eval/goldenset/

# Local assistant/session notes. Repository-wide Codex policy lives in
# AGENTS.md, .agents/, and .codex/ instead.
/.claude/
/CLAUDE.md
/scripts/CLAUDE.md
/GUIDELINE.md
/PROJECT_TOUR.md

