{
  "tool_id": "pinfo",
  "display_name": "Process Information Tool",
  "version_supported": ">1.0.0",
  "category": "memory_analysis",
  "subcategory": "process",
  "applicable_evidence_types": [
    "memory_dump"
  ],
  "platform": "windows",
  "input_format": [
    "dmp"
  ],
  "output_format": "json",
  "output_size_estimate": "small",
  "parallelizable": true,
  "estimated_runtime": "short",
  "install_check": {
    "command": "pinfo --help",
    "expected_pattern": "Usage"
  },
  "command_templates": [
    {
      "name": "basic",
      "template": "pinfo {evidence_path}",
      "when": "when analyzing a memory dump for process information"
    }
  ],
  "usage_description": "PInfo is used to extract detailed process information from memory dumps, aiding in forensic analysis.",
  "suspicious_indicators": [
    {
      "id": "unknown_process",
      "pattern": "Unknown process name detected",
      "severity_baseline": "low",
      "description": "Process with an unknown or suspicious name"
    },
    {
      "id": "unusual_module",
      "pattern": "Uncommon module loaded in process",
      "severity_baseline": "medium",
      "description": "Module not commonly found in legitimate processes"
    }
  ],
  "known_false_positives": [
    ""
  ],
  "reference_urls": [
    "https://github.com/ericzimmerman/pinfo"
  ]
}