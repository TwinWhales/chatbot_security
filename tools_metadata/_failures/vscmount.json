{
  "tool_id": "vscmount",
  "display_name": "VSCMount",
  "version_supported": "",
  "category": "disk_analysis",
  "subcategory": "volume_shadow_copy",
  "applicable_evidence_types": [
    "unknown"
  ],
  "platform": "windows",
  "input_format": [
    "vss"
  ],
  "output_format": "directory",
  "output_size_estimate": "medium",
  "parallelizable": true,
  "estimated_runtime": "short",
  "install_check": {
    "command": ".\\VSCMount.exe --help",
    "expected_pattern": "Usage"
  },
  "command_templates": [
    {
      "name": "mount_volumes",
      "template": ".\\vscmount.exe --dl {evidence_path} --mp C:\\vssroot --ud",
      "when": "When mounting VSS volumes from a forensic image."
    }
  ],
  "usage_description": "VSCMount is used to mount Volume Shadow Copies (VSS) for analysis, providing access to historical data that may no longer exist on the current system state.",
  "suspicious_indicators": [
    {
      "id": "vss_creation_timestamps",
      "pattern": "vss[0-9]+-[0-9]{14}",
      "severity_baseline": "low",
      "description": "Timestamps in symbolic link names may indicate historical data access."
    }
  ],
  "known_false_positives": [
    ""
  ],
  "reference_urls": [
    "https://github.com/EricZimmerman/VSCMount",
    "https://binaryforay.blogspot.com/2018/09/introducing-vscmount.html"
  ]
}